{
  "name": "berlin-vegan-map",
  "version": "4.8.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "_comment": "env-cmd sets environment variables from file ./.env for the following command.",
    "ng": "env-cmd ng",
    "start": "node write-version-info.ts && env-cmd ng serve --open",
    "build": "node write-version-info.ts && env-cmd ng build --configuration production",
    "serve-build": "open-cli http://localhost:8000/ && cd ./dist && ws --spa index.html",
    "test": "env-cmd ng test",
    "lint": "env-cmd ng lint",
    "verify": "npm run lint && npm run build",
    "postinstall": "node write-version-info.ts",
    "lighthouse": "lighthouse-ignore"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Berlin-Vegan/berlin-vegan-map.git"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/cdk": "^18.2.6",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/material": "^18.2.6",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@angular/service-worker": "^18.2.14",
    "@kolkov/ngx-gallery": "^2.0.1",
    "@marco-eckstein/js-utils": "^0.11.1",
    "hammer-timejs": "^1.1.0",
    "hammerjs": "^2.0.8",
    "moment": "^2.24.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@angular/language-service": "^18.2.14",
    "@berlin-vegan/berlin-vegan-data-js": "^0.4.0",
    "@marco-eckstein/lighthouse-ignore": "^0.2.0",
    "@types/googlemaps": "^3.30.17",
    "@types/hammerjs": "^2.0.36",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.54",
    "angular-eslint": "20.3.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.35.0",
    "git-describe": "^4.0.4",
    "jasmine-core": "~5.2.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "local-web-server": "^4.0.0",
    "open-cli": "^5.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~5.5.4",
    "typescript-eslint": "8.40.0"
  }
